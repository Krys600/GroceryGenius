    <string name="webdav_sync_description" tools:ignore="MissingTranslation">Sync your grocery lists, custom groceries and category order through your Nextcloud or any other WebDAV server. All devices connected to the same folder share the same lists, so you can also share them with your family by connecting to a shared folder.</string>
