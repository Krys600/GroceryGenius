<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- WebDAV sync settings contain the server password -->
        <exclude domain="file" path="datastore/webdav_sync.preferences_pb" />
        <exclude domain="file" path="webdav_sync" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/webdav_sync.preferences_pb" />
        <exclude domain="file" path="webdav_sync" />
    </device-transfer>
</data-extraction-rules>